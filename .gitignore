# ==========================================
# DroidForensix Gitignore Configuration
# Allowlist-based approach: explicitly exclude only what we don't want
# ==========================================

# Environment and secrets (NEVER commit these)
.env
.env.*
keys.txt
setenv.sh

# IDE & Editor files
.vscode/
.idea/
.mcp.json
.windsurfrules
.cursor/
.jetro/
.claude/
.gemini/
.kiro/
.qoder/
.agents/
.cursorrules
.github/code-review-graph.instruction.md
.opencode.json
AGENTS.md
GEMINI.md
QODER.md

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node modules
node_modules/

# Build & dist
dist/
build/
*.egg-info/

# Local development directories
.worktrees/
.vite/
ss/
.code-review-graph/
graphify-out/
claude_files/
reports/
data/
samples/
CICAndMal2017/
koodous/
analysis/work/

# Local tools bin directory
tools/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary/scratch files
*.log
*.tmp
*.bak

gstack/