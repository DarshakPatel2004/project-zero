# ==========================================
# DroidForensix Gitignore Configuration
# Deny-by-default to only allow project files
# ==========================================

# 1. Ignore everything by default
*

# 2. Allow traversing directories to find allowed files
!**/

# 3. Do not traverse or allow anything in these specific directories
.git/
.venv/
venv/
node_modules/
.pytest_cache/
.code-review-graph/
graphify-out/
claude_files/
reports/
data/
samples/
CICAndMal2017/
koodous/
__pycache__/
analysis/work/

# 4. Allow Project Source Files
!**/*.py
!**/*.js
!**/*.jsx
!**/*.html
!**/*.css

# 5. Allow Assets
!**/*.svg
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.ico
!**/*.gif

# 6. Allow Project Configurations and Metadata
!**/.gitignore
!**/requirements.txt
!**/package.json
!**/package-lock.json
!**/vite.config.js
!**/eslint.config.js
!**/opencode.json

# 7. Explicitly ignore environment and secrets files
.env
.env.*
keys.txt
setenv.sh
