# ==========================================
# DroidForensix Gitignore Configuration
# Deny-by-default to only allow project files
# ==========================================

# 1. Ignore everything by default
*

# 2. Allow traversing directories to find allowed files
!**/

# 5. Allow Assets
!**/*.svg
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.ico
!**/*.gif

# 6. Allow Project Configurations and Metadata
!**/.gitignore
!**/requirements.txt
!**/package.json
!**/package-lock.json
!**/vite.config.js
!**/eslint.config.js
!**/opencode.json

# Validation reports
!VALIDATION_REPORT.md
!FAILURE_ANALYSIS.md

# 7. Explicitly ignore environment and secrets files
.env
.env.*
keys.txt
setenv.sh

# 3. Do not traverse or allow anything in these specific directories
.git/
.venv/
venv/
node_modules/
.pytest_cache/
.code-review-graph/
graphify-out/
claude_files/
reports/
data/
samples/
CICAndMal2017/
koodous/
__pycache__/
analysis/work/

# IDE & Editor files
.vscode/
.idea/
.mcp.json
.windsurfrules
.cursor/
.jetro/
.claude/
.gemini/
.kiro/
.qoder/
.agents/
.cursorrules
.github/code-review-graph.instruction.md
.opencode.json
AGENTS.md
GEMINI.md
QODER.md

# Added by code-review-graph
.code-review-graph/

# Local tools bin directory
tools/

# OS
.DS_Store
Thumbs.db
